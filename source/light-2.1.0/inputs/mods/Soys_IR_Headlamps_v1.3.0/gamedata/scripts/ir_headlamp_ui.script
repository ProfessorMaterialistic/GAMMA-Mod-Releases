local GUI = nil

local DEFAULT_BRIGHTNESS = 0.55
local DEFAULT_RANGE = 30
local DEFAULT_BEAM_SIZE = 50

class "IRHeadlampDialog" (CUIScriptWnd)

local function tr(key, fallback)
    local translated = game.translate_string(key)

    if translated == nil
    or translated == ""
    or translated == key then
        return fallback
    end

    return translated
end


function IRHeadlampDialog:__init() super()
    self:InitControls()
    self:InitCallbacks()
end

function IRHeadlampDialog:__finalize()
    GUI = nil
end


local function bool_text(value)
    return tr(
        value and "ui_ir_status_on" or "ui_ir_status_off",
        value and "On" or "Off"
    )
end


local function get_mcm(path, default)
    if ui_mcm and ui_mcm.get then
        local value = ui_mcm.get(path)

        if value ~= nil then
            return value
        end
    end

    return default
end


local function set_mcm(path, value)
    if ui_mcm and ui_mcm.set then
        ui_mcm.set(path, value)
        return true
    end

    return false
end


local function different(a, b, tolerance)
    return math.abs((tonumber(a) or 0) - (tonumber(b) or 0))
        > (tolerance or 0.0001)
end


local function slider_to_range(slider_value)
    local value = tonumber(slider_value) or 0
    return math.floor(5 + (value * 95) + 0.5)
end


local function slider_to_beam(slider_value)
    local value = tonumber(slider_value) or 0
    return math.floor(10 + (value * 110) + 0.5)
end


function IRHeadlampDialog:InitControls()
    self:SetWndRect(Frect():set(0, 0, 1024, 768))
    self:SetAutoDelete(true)

    local xml = CScriptXmlInit()
    xml:ParseFile("ui_ir_headlamp.xml")

    self.back = xml:InitStatic("background", self)

    local caption = xml:InitStatic("caption", self.back)
    caption:TextControl():SetText(
        tr("ui_ir_panel_title", "IR Headlamp Settings")
    )

    local subtitle = xml:InitStatic("subtitle", self.back)
    subtitle:TextControl():SetText(
        tr("ui_ir_panel_subtitle", "Customize the equipped IR headlamp")
    )

    local status_title = xml:InitStatic("status_title", self.back)
    status_title:TextControl():SetText(
        tr("ui_ir_status_title", "Status")
    )

    self.lbl_equipped = xml:InitTextWnd("status_equipped", self.back)
    self.lbl_deployed = xml:InitTextWnd("status_deployed", self.back)
    self.lbl_torch = xml:InitTextWnd("status_torch", self.back)

    local lbl_ir = xml:InitStatic("lbl_ir_enabled", self.back)
    lbl_ir:TextControl():SetText(
        tr("ui_ir_enabled", "IR Enabled")
    )
    self.chk_ir = xml:InitCheck("chk_ir_enabled", self.back)

    local lbl_brightness = xml:InitStatic("lbl_brightness", self.back)
    lbl_brightness:TextControl():SetText(
        tr("ui_ir_brightness", "Brightness")
    )
    self.track_brightness = xml:InitTrackBar("track_brightness", self.back)
    self.track_brightness:SetOptFBounds(0.10, 1.20)
    self.track_brightness:SetStep(0.05)
    self.value_brightness = xml:InitTextWnd("value_brightness", self.back)

    local lbl_range = xml:InitStatic("lbl_range", self.back)
    lbl_range:TextControl():SetText(
        tr("ui_ir_range", "Range")
    )
    self.track_range = xml:InitTrackBar("track_range", self.back)
    self.track_range:SetOptFBounds(5, 100)
    self.track_range:SetStep(1)
    self.value_range = xml:InitTextWnd("value_range", self.back)

    local lbl_beam = xml:InitStatic("lbl_beam_size", self.back)
    lbl_beam:TextControl():SetText(
        tr("ui_ir_beam_size", "Beam Size")
    )
    self.track_beam = xml:InitTrackBar("track_beam_size", self.back)
    self.track_beam:SetOptFBounds(10, 120)
    self.track_beam:SetStep(1)
    self.value_beam = xml:InitTextWnd("value_beam_size", self.back)

    local lbl_sync = xml:InitStatic("lbl_auto_sync", self.back)
    lbl_sync:TextControl():SetText(
        tr("ui_ir_auto_sync", "Auto-sync with Night Vision")
    )
    self.chk_sync = xml:InitCheck("chk_auto_sync", self.back)

    local lbl_sound = xml:InitStatic("lbl_play_sound", self.back)
    lbl_sound:TextControl():SetText(
        tr("ui_ir_play_sound", "Play Toggle Sound")
    )
    self.chk_sound = xml:InitCheck("chk_play_sound", self.back)

    local required = xml:InitStatic("required_notice", self.back)
    required:TextControl():SetText(
        tr("ui_ir_required_notice", "Requires compatible night vision to see the IR beam.")
    )

    self.btn_reset = xml:Init3tButton("btn_reset", self.back)
    self.btn_reset:TextControl():SetText(
        tr("ui_ir_reset", "Reset to Defaults")
    )
    self:Register(self.btn_reset, "btn_reset")

    self.btn_close = xml:Init3tButton("btn_close", self.back)
    self.btn_close:TextControl():SetText(
        tr("ui_ir_close", "Close")
    )
    self:Register(self.btn_close, "btn_close")
end


function IRHeadlampDialog:InitCallbacks()
    self:AddCallback(
        "btn_close",
        ui_events.BUTTON_CLICKED,
        self.Close,
        self
    )

    self:AddCallback(
        "btn_reset",
        ui_events.BUTTON_CLICKED,
        self.Reset,
        self
    )
end


function IRHeadlampDialog:LoadSettingsIntoControls()
    local brightness = tonumber(
        get_mcm(
            "ir_headlamp/brightness",
            DEFAULT_BRIGHTNESS
        )
    ) or DEFAULT_BRIGHTNESS

    local range = tonumber(
        get_mcm(
            "ir_headlamp/range",
            DEFAULT_RANGE
        )
    ) or DEFAULT_RANGE

    local beam_size = tonumber(
        get_mcm(
            "ir_headlamp/beam_size",
            DEFAULT_BEAM_SIZE
        )
    ) or DEFAULT_BEAM_SIZE

    self.track_brightness:SetFValue(brightness)
    self.track_range:SetFValue(range)
    self.track_beam:SetFValue(beam_size)
end


function IRHeadlampDialog:Refresh()
    local status = ir_headlamp.get_status()

    self.chk_ir:SetCheck(status.enabled)
    self.chk_sync:SetCheck(status.auto_sync)
    self.chk_sound:SetCheck(status.play_sound)

    self.lbl_equipped:SetText(
        tr("ui_ir_status_equipped", "Headlamp Equipped")
        .. ": "
        .. bool_text(status.equipped)
    )

    self.lbl_deployed:SetText(
        tr("ui_ir_status_deployed", "Night Vision Deployed")
        .. ": "
        .. bool_text(status.deployed)
    )

    self.lbl_torch:SetText(
        tr("ui_ir_status_torch", "IR Light Active")
        .. ": "
        .. bool_text(status.torch)
    )

    self.value_brightness:SetText(
        string.format("%.2f", self.track_brightness:GetFValue())
    )

    self.value_range:SetText(
        string.format(
            "%d m",
            math.floor(self.track_range:GetFValue() + 0.5)
        )
    )

    self.value_beam:SetText(
        string.format(
            "%d deg",
            math.floor(self.track_beam:GetFValue() + 0.5)
        )
    )
end


function IRHeadlampDialog:ShowPanel()
    self:LoadSettingsIntoControls()
    self:Refresh()
    self:ShowDialog(true)

    Register_UI(
        "IRHeadlampDialog",
        "ir_headlamp_ui"
    )
end


function IRHeadlampDialog:Update()
    CUIScriptWnd.Update(self)

    if not self:IsShown() then
        return
    end

    local status = ir_headlamp.get_status()

    local requested_ir = self.chk_ir:GetCheck()

    if requested_ir ~= status.enabled then
        ir_headlamp.set_ir_enabled(requested_ir)
    end

    local requested_sync = self.chk_sync:GetCheck()

    if requested_sync ~= status.auto_sync then
        set_mcm("ir_headlamp/auto_sync", requested_sync)
    end

    local requested_sound = self.chk_sound:GetCheck()

    if requested_sound ~= status.play_sound then
        set_mcm("ir_headlamp/play_sound", requested_sound)
    end

    local brightness = self.track_brightness:GetFValue()
    local range = math.floor(self.track_range:GetFValue() + 0.5)
    local beam_size = math.floor(self.track_beam:GetFValue() + 0.5)

    if different(
        brightness,
        get_mcm("ir_headlamp/brightness", DEFAULT_BRIGHTNESS),
        0.001
    ) then
        set_mcm("ir_headlamp/brightness", brightness)
    end

    if different(
        range,
        get_mcm("ir_headlamp/range", DEFAULT_RANGE)
    ) then
        set_mcm("ir_headlamp/range", range)
    end

    if different(
        beam_size,
        get_mcm("ir_headlamp/beam_size", DEFAULT_BEAM_SIZE)
    ) then
        set_mcm("ir_headlamp/beam_size", beam_size)
    end

    self:Refresh()
end


function IRHeadlampDialog:Reset()
    set_mcm("ir_headlamp/brightness", DEFAULT_BRIGHTNESS)
    set_mcm("ir_headlamp/range", DEFAULT_RANGE)
    set_mcm("ir_headlamp/beam_size", DEFAULT_BEAM_SIZE)
    set_mcm("ir_headlamp/auto_sync", true)
    set_mcm("ir_headlamp/play_sound", true)

    ir_headlamp.set_ir_enabled(false)

    self:LoadSettingsIntoControls()
    self:Refresh()
end


function IRHeadlampDialog:OnKeyboard(dik, keyboard_action)
    local res = CUIScriptWnd.OnKeyboard(
        self,
        dik,
        keyboard_action
    )

    if res == false
    and keyboard_action == ui_events.WINDOW_KEY_PRESSED
    and dik == DIK_keys.DIK_ESCAPE then
        self:Close()
    end

    return res
end


function IRHeadlampDialog:Close()
    if self:IsShown() then
        self:HideDialog()
    end

    Unregister_UI(
        "IRHeadlampDialog"
    )
end


function open_dialog()
    if GUI and GUI:IsShown() then
        GUI:Close()
        return
    end

    if not GUI then
        GUI = IRHeadlampDialog()
    end

    GUI:ShowPanel()
end
