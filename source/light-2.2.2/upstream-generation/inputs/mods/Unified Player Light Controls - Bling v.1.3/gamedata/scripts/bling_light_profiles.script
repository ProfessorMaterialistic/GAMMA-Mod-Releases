-- Shared weapon-family identity and separately versioned Visible/IR defaults.
local fields={weapon={"brightness","range","cone","r","g","b","aim_policy"},ir={"brightness","range","cone_deg","aim_policy"},laser={"brightness","dot_size","beam_brightness","beam_size","hue","no_laser_primary_aim","no_laser_alt_aim","policy"}}
local function read(k,d) local v=axr_main.config:r_value("mcm",k,2);if v==nil then return d end;return v end
local function write(k,v) axr_main.config:w_value("mcm",k,v) end
local function prefix(mode,id) return "bling_light_profiles/"..mode.."/"..id.."/" end
function family(section)
    if type(section)~="string" then return section end
    -- Modular attachments retain their own identity.
    if string.sub(section,1,4)~="wpn_" then return section end
    local current=section;local seen={[current]=true}
    for i=1,32 do
        local parent=ini_sys:r_string_ex(current,"parent_section")
        if not parent or parent=="" or parent==current then return current end
        if seen[parent] then return section end -- malformed cycle: do not merge families
        if string.sub(parent,1,4)~="wpn_" or not ini_sys:section_exist(parent) then return current end
        seen[parent]=true;current=parent
    end
    return section
end
function get(mode,id,key,default)
    local raw=id;id=family(id)
    local p=prefix(mode,id);local g=prefix(mode,"all")
    local generation=read(g.."generation",0)
    if read(p.."generation",0)>=generation then
        local v=read(p..key,nil);if v~=nil then return v end
    end
    if generation>0 then return read(g..key,default) end
    if mode=="weapon" then
        local old="bling_player_lights/weapon/"
        local v=read(old..id.."/"..key,nil)
        if v==nil then v=read(old..raw.."/"..key,nil) end
        if v~=nil then
            write(p..key,v);axr_main.config:save();return v
        end
    end
    return default
end
function put(mode,id,values,defaults)
    id=family(id);local p=prefix(mode,id)
    local effective={}
    for _,key in ipairs(fields[mode]) do
        effective[key]=values[key]
        if effective[key]==nil then effective[key]=get(mode,id,key,defaults and defaults[key]) end
    end
    for key,v in pairs(effective) do write(p..key,v) end
    write(p.."generation",read(prefix(mode,"all").."generation",0))
    axr_main.config:save()
end
function apply_all(mode,values)
    local p=prefix(mode,"all")
    for _,key in ipairs(fields[mode]) do assert(type(values[key])=="number","Missing global light field: "..key) end
    for _,key in ipairs(fields[mode]) do write(p..key,values[key]) end
    write(p.."generation",read(p.."generation",0)+1);axr_main.config:save()
end
local hooked=false
function install_ir()
    if hooked or not utlf_ir_mode or type(utlf_ir_mode.get_ir_settings)~="function" then return end
    local ir=utlf_ir_mode
    local old_get,old_set,old_reset=ir.get_ir_settings,ir.set_ir_settings,ir.reset_ir_settings
    ir.get_ir_settings=function(id,profile)
        if not id then return nil end
        local original=old_get(family(id),profile)
        if not original then return nil end
        -- Preserve metadata/defaults expected by the original UI/runtime.
        local result={};for k,v in pairs(original) do result[k]=v end
        for _,key in ipairs(fields.ir) do result[key]=get("ir",id,key,key=="aim_policy" and 0 or original[key]) end
        result.section=family(id);return result
    end
    ir.set_ir_settings=function(id,range,cone,brightness)
        if not id then return false end
        id=family(id)
        local ok=old_set(id,range,cone,brightness)
        if ok then local s=old_get(id);put("ir",id,{range=s.range,cone_deg=s.cone_deg,brightness=s.brightness},s) end
        return ok
    end
    ir.reset_ir_settings=function(id,profile)
        if not id then return false end
        id=family(id);local ok=old_reset(id,profile)
        if ok then local s=old_get(id,profile);put("ir",id,{range=s.range,cone_deg=s.cone_deg,brightness=s.brightness,aim_policy=0},s) end
        return ok
    end
    hooked=true
end
function on_game_start() RegisterScriptCallback("actor_on_first_update",install_ir) end
