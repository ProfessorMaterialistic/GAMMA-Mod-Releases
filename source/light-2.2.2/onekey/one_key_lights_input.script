local cfg={enabled=true,key=0,tap="headlamp",double="utlf_visible",hold="laser",double_ms=225,hold_ms=300,shortcut=true,modifier=1}
local armed=false
local fsm=one_key_lights_gesture.new()
local chord,gesture_cfg,pressed,momentary_token
local last_update,pressed_at
local function tactical() return light_compat.module("light_tactical") end
local function usable() return db and db.actor and db.actor:alive() and not device():is_paused() and actor_menu.is_hud_free() end
function owns_key(key)
    return armed and cfg.enabled and (usable() or one_key_lights_menu.is_open()) and ((cfg.key>0 and key==cfg.key) or cfg.menu_key and cfg.menu_key>0 and key==cfg.menu_key) or false
end
function reset()
    if momentary_token and tactical() then tactical().release(momentary_token) end
    momentary_token=nil;pressed=false;chord=nil;gesture_cfg=nil;last_update=nil;pressed_at=nil
    one_key_lights_gesture.reset(fsm)
end
function settings() return cfg end
function load_settings()
    if one_key_lights_menu.is_open() then one_key_lights_menu.close() end
    reset()
    if ui_mcm then ui_mcm.get(one_key_lights_mcm.path("enabled")) end
    for name,default in pairs(one_key_lights_mcm.defaults) do
        local value=ui_mcm and ui_mcm.get(one_key_lights_mcm.path(name));if value==nil then value=default end;cfg[name]=value
    end
    for _,name in ipairs({"alt","ctrl","shift"}) do cfg["enable_"..name]=one_key_lights_mcm.modifier_enabled(name) end
    cfg.key=tonumber(cfg.key) or 0;cfg.menu_key=tonumber(cfg.menu_key) or -1
    cfg.double_ms=math.max(100,math.min(500,tonumber(cfg.double_ms) or 225))
    cfg.hold_ms=math.max(150,math.min(1000,tonumber(cfg.hold_ms) or 300));armed=true
end
local function modifier()
    local keys={{DIK_keys.DIK_LSHIFT,DIK_keys.DIK_RSHIFT},{DIK_keys.DIK_LCONTROL,DIK_keys.DIK_RCONTROL},{DIK_keys.DIK_LMENU,DIK_keys.DIK_RMENU}}
    local k=keys[tonumber(cfg.modifier) or 1];return k and ((key_state(k[1]) or 0)~=0 or (key_state(k[2]) or 0)~=0)
end
local function transition(event)
    for _,effect in ipairs(one_key_lights_gesture.step(fsm,event,time_global(),gesture_cfg or cfg)) do
        if effect.momentary then
            momentary_token={}
            if tactical() then tactical().begin(effect.action,momentary_token) end
        elseif effect.action=="quick_menu" then one_key_lights_menu.open(event=="menu" and cfg.menu_key or cfg.key,effect.held,cfg.menu_selection,event=="menu")
        else one_key_lights_actions.run(effect.action) end
    end
end
function on_press(key,bind,dis,flags)
    if key==1 or key==219 or key==220 or key==15 then
        reset();if tactical() then tactical().cancel("menu or focus key") end
    end
    local matrix=light_compat.module("one_key_lights_matrix")
    if chord and matrix and matrix.modifier()~=chord then reset() end
    if not owns_key(key) then return end
    if dis then reset();return end
    if flags then flags.ret_value=false end
    if one_key_lights_menu.is_open() then one_key_lights_menu.press(key);return end
    if key==cfg.key then
        if pressed then return end -- key repeats cannot start another lease
        local matrix=light_compat.module("one_key_lights_matrix")
        local current=matrix and matrix.modifier() or "none"
        if current=="conflict" then reset();return end
        if chord and chord~=current then reset() end
        local route=current
        if matrix and not matrix.enabled(cfg,current) then
            if not matrix.any_enabled(cfg) and cfg.shortcut and modifier() then transition("modifier");return end
            -- A disabled modifier must not swallow ordinary light controls
            -- while Shift/Ctrl/Alt is held for movement. Keep the physical
            -- chord separately so changing it still cancels pending actions.
            route="none"
        end
        chord=current;pressed=true;pressed_at=time_global()
        if matrix then
            gesture_cfg=matrix.mapping(cfg,route);transition("press");return
        end
    end
    if key==cfg.menu_key and key~=cfg.key then transition("menu")
    elseif cfg.shortcut and modifier() then transition("modifier")
    else transition("press") end
end
function on_release(key,bind,dis,flags)
    -- Release must clean up even after menus, pause or ownership changes.
    if key==cfg.key and momentary_token then reset();if flags then flags.ret_value=false end;return end
    if key==cfg.key then pressed=false end
    local matrix=light_compat.module("one_key_lights_matrix")
    if chord and matrix and matrix.modifier()~=chord then reset();return end
    if not owns_key(key) then return end
    if dis then reset();return end
    if flags then flags.ret_value=false end
    if one_key_lights_menu.release(key) then reset();return end
    if key==cfg.key then transition("release") end
end
function on_hold(key,bind,dis,flags) if not dis and owns_key(key) and flags then flags.ret_value=false end end
function update()
    light_compat.tick()
    if tactical() then tactical().update() end
    if not armed then return end
    if one_key_lights_menu.is_open() then return end
    if not cfg.enabled or not usable() then reset();return end
    local now=time_continual and time_continual() or time_global()
    if last_update and (now<last_update or now-last_update>1000) then reset();return end
    last_update=now
    if pressed and pressed_at and time_global()-pressed_at>30 and key_state then
        local down=key_state(cfg.key)
        if down==false or down==0 then reset();return end
    end
    local matrix=light_compat.module("one_key_lights_matrix")
    if chord and matrix and matrix.modifier()~=chord then reset();return end
    transition("tick")
    one_key_lights_standalone.update()
end
function on_game_start()
    RegisterScriptCallback("actor_on_first_update",load_settings)
    RegisterScriptCallback("on_option_change",load_settings)
    RegisterScriptCallback("on_before_key_press",on_press)
    RegisterScriptCallback("on_before_key_release",on_release)
    RegisterScriptCallback("on_before_key_hold",on_hold)
    RegisterScriptCallback("actor_on_update",update)
    RegisterScriptCallback("on_game_load",reset)
    RegisterScriptCallback("load_state",reset)
    for _,event in ipairs({"ActorMenu_on_before_init_mode","main_menu_on_init","actor_on_before_death","actor_on_net_destroy","on_before_level_changing"}) do
        RegisterScriptCallback(event,reset)
    end
end
