local GUI=nil
class "BlingPlayerLightsDialog" (CUIScriptWnd)
function BlingPlayerLightsDialog:__init() super()
    self:SetWndRect(Frect():set(0,0,1024,768));self:SetAutoDelete(true)
    local xml=CScriptXmlInit();xml:ParseFile("ui_bling_player_lights.xml")
    self.back=xml:InitStatic("background",self)
    xml:InitStatic("caption",self.back):TextControl():SetText("UTLF WHITE LIGHT")
    xml:InitStatic("subtitle",self.back):TextControl():SetText("VISIBLE ILLUMINATION CONTROL")
    self.status=xml:InitTextWnd("status_torch",self.back)
    self.equipment=xml:InitTextWnd("equipment",self.back)
    xml:InitStatic("lbl_enabled",self.back):Show(false)
    self.enabled=xml:InitCheck("chk_enabled",self.back)
    self.enabled:Show(false) -- replaced by the shared OFF / ON / AUTO buttons
    bling_light_aim.init(self,xml,self.back,"weapon")
    self.tracks={};self.values={}
    local limits=bling_player_lights.bounds("weapon")
    for i,key in ipairs({"brightness","range","beam_size"}) do
        xml:InitStatic("lbl_"..key,self.back):TextControl():SetText(({"Brightness (multiplier)","Range","Beam Size"})[i])
        self.tracks[i]=xml:InitTrackBar("track_"..key,self.back)
        self.tracks[i]:SetOptFBounds(limits[i][1],limits[i][2]);self.tracks[i]:SetStep(limits[i][3])
        self.values[i]=xml:InitTextWnd("value_"..key,self.back)
    end
    xml:InitStatic("lbl_color",self.back):TextControl():SetText("Light Color")
    bling_player_lights.init_color_buttons(self,xml,self.back,"weapon")
    local all=xml:Init3tButton("bling_all",self.back)
    all:TextControl():SetText("Save and Apply to ALL Weapons and Lights")
    self:Register(all,"bling_all");self:AddCallback("bling_all",ui_events.BUTTON_CLICKED,self.ApplyAll,self)
    self.notice=xml:InitStatic("notice",self.back)
    for _,key in ipairs({"reset","close"}) do
        local btn=xml:Init3tButton("btn_"..key,self.back)
        btn:TextControl():SetText(key=="reset" and "Reset Defaults" or "Close");self:Register(btn,key)
    end
    self:AddCallback("reset",ui_events.BUTTON_CLICKED,self.Reset,self)
    self:AddCallback("close",ui_events.BUTTON_CLICKED,self.Close,self)
end
function BlingPlayerLightsDialog:Load()
    self.context=bling_player_lights.context(1)
    local c=self.context
    self.enabled:SetCheck(bling_player_lights.weapon_enabled())
    local v=c and {c.brightness,c.range,c.cone} or {1,48,50}
    for i=1,3 do self.tracks[i]:SetFValue(v[i]);self.tracks[i]:Enable(c~=nil) end
    self.enabled:Enable(c~=nil)
    self:Refresh()
end
function BlingPlayerLightsDialog:Refresh()
    bling_light_aim.refresh(self,"weapon")
    local c=self.context
    self.equipment:SetText(c and ("Weapon / Light: "..c.id) or "Equip a supported weapon with a light attached")
    local ir=utlf_ir_mode and utlf_ir_mode.is_ir_active()
    self.enabled:SetCheck(bling_player_lights.weapon_enabled())
    self.enabled:Enable(c~=nil and not ir)
    self.last_enabled=self.enabled:GetCheck()
    local state=utlf_core and utlf_core.get_state()
    self.status:SetText("Weapon Light Active: "..(state and state.light and state.light.enabled and not ir and "YES" or "NO"))
    self.notice:TextControl():SetText(ir and "IR active. Visible settings apply in white-light mode." or "Saved automatically for this weapon / light.")
    bling_player_lights.refresh_color_buttons(self,"weapon",c and c.id)
    self.values[1]:SetText(string.format("%.2fx",self.tracks[1]:GetFValue()))
    self.values[2]:SetText(string.format("%d m",math.floor(self.tracks[2]:GetFValue()+0.5)))
    self.values[3]:SetText(string.format("%d deg",math.floor(self.tracks[3]:GetFValue()+0.5)))
end
function BlingPlayerLightsDialog:Update()
    CUIScriptWnd.Update(self)
    if not self:IsShown() then return end
    local c=bling_player_lights.context(1)
    if (c and c.id)~=(self.context and self.context.id) then self:Load();return end
    if c then
        local requested=self.enabled:GetCheck()
        if requested~=self.last_enabled then bling_player_lights.set_weapon_enabled(requested) end
        local v={};for i=1,3 do v[i]=self.tracks[i]:GetFValue() end
        if math.abs(v[1]-c.brightness)>0.001 or math.abs(v[2]-c.range)>0.001 or math.abs(v[3]-c.cone)>0.001 then
            bling_player_lights.save(c,v)
        end
    end
    self:Refresh()
end
function BlingPlayerLightsDialog:Color()
    local c=bling_player_lights.context(1)
    if not c or not self.context or c.id~=self.context.id then self:Load();return end
    bling_player_lights.next_preset("weapon",c.id);self:Refresh()
end
function BlingPlayerLightsDialog:Reset()
    local c=bling_player_lights.context(1)
    if not c or not self.context or c.id~=self.context.id then self:Load();return end
    bling_player_lights.save(c,{1,c.profile.range or 48,c.profile.cone_deg or 50,1,1,1})
    bling_light_profiles.put("weapon",c.id,{aim_policy=0},bling_light_aim.snapshot("weapon",c))
    bling_light_control.reset_policy("weapon")
    bling_light_aim.update()
    self:Load()
end
function BlingPlayerLightsDialog:ShowPanel()
    self:Load();self:ShowDialog(true);Register_UI("BlingPlayerLightsDialog","bling_player_lights_ui")
end
function BlingPlayerLightsDialog:Close()
    if self:IsShown() then self:HideDialog() end
    Unregister_UI("BlingPlayerLightsDialog")
end
function BlingPlayerLightsDialog:OnKeyboard(dik,action)
    local result=CUIScriptWnd.OnKeyboard(self,dik,action)
    if result==false and action==ui_events.WINDOW_KEY_PRESSED and dik==DIK_keys.DIK_ESCAPE then self:Close() end
    return result
end
function BlingPlayerLightsDialog:__finalize() GUI=nil end
function open_dialog()
    if GUI and GUI:IsShown() then GUI:Close();return end
    if not GUI then GUI=BlingPlayerLightsDialog() end
    GUI:ShowPanel()
end

function BlingPlayerLightsDialog:ApplyAll()
    local c=bling_player_lights.context(1)
    if not c or not self.context or c.id~=self.context.id then self:Load();return end
    local r,g,b=bling_player_lights.rgb("weapon",c.id)
    bling_light_profiles.apply_all("weapon",{brightness=self.tracks[1]:GetFValue(),range=self.tracks[2]:GetFValue(),cone=self.tracks[3]:GetFValue(),r=r,g=g,b=b,aim_policy=bling_light_aim.policy("weapon",c.id)})
    bling_player_lights.normal_update();self:Load()
    self.notice:TextControl():SetText("Visible settings applied to all weapons and lights.")
end
